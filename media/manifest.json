{
  "schemaVersion": 1,
  "description": "Cadena de herramientas multimedia del editor. Build nativo Windows x64 preparado para desarrollo; los binarios no se commitean (.gitignore) y se reconstruyen con scripts/prepare-editor-media.js.",
  "build": {
    "name": "ffmpeg-9.0.1-win32-x64 (BtbN-style full build, GPL v3)",
    "version": "n9.0.1-11-ge47273f4d9-20260831",
    "source": "https://github.com/BtbN/FFmpeg-Builds",
    "configurationFlags": [
      "--enable-gpl",
      "--enable-version3",
      "--enable-libx264",
      "--enable-libx265",
      "--enable-libvpx",
      "--enable-libopus",
      "--enable-libmp3lame",
      "--enable-libvidstab",
      "--enable-librubberband",
      "--enable-libwebp",
      "--enable-libfreetype",
      "--enable-fontconfig",
      "--enable-libass",
      "--enable-libfribidi"
    ],
    "license": "GPL-3.0-or-later",
    "licenseNotes": "Incluye filtros GPL (delogo), vid.stab y rubberband. La distribución del producto debe acompañar el instalador con los avisos de licencia y la oferta de código fuente de los componentes GPL/LGPL. Ver media/LICENSE-THIRD-PARTY.md.",
    "capabilities": {
      "filters": ["delogo", "vidstabdetect", "vidstabtransform", "rubberband", "atempo", "boxblur", "chromakey", "colorkey", "ebur128", "colorchannelmixer", "drawtext"],
      "videoEncoders": ["libx264", "libx265", "libvpx-vp9", "libwebp", "apng", "png", "mjpeg"],
      "audioEncoders": ["aac", "libopus", "libmp3lame"]
    }
  },
  "binaries": [
