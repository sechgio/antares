{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Antares Connections catalog",
  "version": 1,
  "description": "Catálogo de proveedores externos conectables por OAuth. Cada proveedor declara sus URLs de autorización/token, los scopes pedidos y cómo sondear el estado. Las credenciales de app (client_id/secret) las aporta el usuario y se guardan cifradas; los tokens igual. El backend usa este mismo catálogo para refrescar tokens al ejecutar nodos http_request con connection_ref. `category` agrupa al proveedor en la pestaña Conexiones; `categories` define el orden y las etiquetas de esos grupos.",
  "categories": [
    { "id": "desarrollo", "label": "Desarrollo" },
    { "id": "comunicacion", "label": "Comunicación" },
    { "id": "documentos", "label": "Documentos" },
    { "id": "planificacion", "label": "Planificación" },
    { "id": "diseno", "label": "Diseño" },
    { "id": "productividad", "label": "Productividad" }
  ],
  "providers": {
    "github": {
      "label": "GitHub",
      "description": "Repos, issues y API REST de GitHub",
      "docs": "https://github.com/settings/developers",
      "category": "desarrollo",
      "auth": {
        "type": "oauth_secret",
        "authorize_url": "https://github.com/login/oauth/authorize",
        "token_url": "https://github.com/login/oauth/access_token",
        "token_auth": "form",
        "scopes": ["repo", "read:user", "workflow"],
        "callback_port": 42831,
        "callback_path": "/callback",
        "requires_client_secret": true,
        "extra_authorize": {},
        "extra_token": {}
      },
      "token_hosts": [
        "api.github.com",
        "github.com",
        "uploads.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com"
      ],
      "status": {
        "url": "https://api.github.com/user",
        "account_field": "login",
        "headers": { "X-GitHub-Api-Version": "2022-11-28" }
      }
    },
    "gitlab": {
      "label": "GitLab",
      "description": "Repos, merge requests y API de GitLab",
      "docs": "https://gitlab.com/-/user_settings/applications",
      "category": "desarrollo",
      "auth": {
        "type": "oauth_pkce",
        "authorize_url": "https://gitlab.com/oauth/authorize",
        "token_url": "https://gitlab.com/oauth/token",
        "token_auth": "form",
        "scopes": ["api", "read_user"],
        "callback_port": 42833,
        "callback_path": "/callback",
        "requires_client_secret": false,
        "extra_authorize": {},
        "extra_token": {}
      },
      "token_hosts": ["gitlab.com"],
      "status": {
        "url": "https://gitlab.com/api/v4/user",
        "account_field": "username",
        "headers": {}
      }
    },
    "bitbucket": {
      "label": "Bitbucket",
      "description": "Repos, pull requests y pipelines de Bitbucket",
      "docs": "https://support.atlassian.com/bitbucket-cloud/docs/use-oauth-on-bitbucket-cloud/",
      "category": "desarrollo",
      "auth": {
        "type": "oauth_secret",
        "authorize_url": "https://bitbucket.org/site/oauth2/authorize",
        "token_url": "https://bitbucket.org/site/oauth2/access_token",
        "token_auth": "basic",
        "scopes": ["account", "repository", "pullrequest"],
        "callback_port": 42834,
        "callback_path": "/callback",
        "requires_client_secret": true,
        "extra_authorize": {},
        "extra_token": {}
      },
      "token_hosts": ["api.bitbucket.org", "bitbucket.org"],
      "status": {
        "url": "https://api.bitbucket.org/2.0/user",
        "account_field": "username",
        "headers": {}
      }
    },
    "slack": {
      "label": "Slack",
