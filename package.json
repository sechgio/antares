{
  "name": "antares-app",
  "version": "0.11.10",
  "description": "Antares",
  "author": "Antares <dev@antares.app>",
  "private": true,
  "main": "electron/main.js",
  "homepage": ".",
  "repository": {
    "type": "git",
    "url": "https://github.com/sechgio/antares.git"
  },
  "bugs": {
    "url": "https://github.com/sechgio/antares/issues"
  },
  "scripts": {
    "dev": "concurrently \"cd frontend && npm run dev\" \"wait-on http://localhost:5173 && electron electron/main.js\"",
    "preview:unpacked": "npm run dist:dir && node scripts/run-unpacked.js",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "node scripts/build-backend.js",
    "clean:dist-electron": "node scripts/clean-dist-electron.js",
    "clean:after-package": "node scripts/clean-after-package.js",
    "build:win": "concurrently \"npm run build:backend\" \"npm run build:frontend\" && npm run clean:dist-electron && electron-builder --win && npm run clean:after-package",
    "dist": "npm run build:win",
    "dist:dir": "concurrently \"npm run build:backend\" \"npm run build:frontend\" && npm run clean:dist-electron && electron-builder --win --dir",
    "test": "node scripts/run-test-suites.js",
    "test:frontend": "cd frontend && npm run test:all",
    "test:stress": "cd backend && uv run --project .. --locked --extra dev pytest ../tests/test_stress_conversion.py -v -m slow",
    "lint:python": "uv run --project . --locked --extra dev ruff check backend tests scripts",
    "lint:fix": "uv run --project . --locked --extra dev ruff check backend tests scripts --fix",
    "typecheck:backend": "uv run --project . --locked --extra dev mypy backend",
    "typecheck:frontend": "cd frontend && npx tsc --noEmit",
    "audit:python": "uv run --project . --locked --extra dev pip-audit .",
    "audit:node": "npm audit --omit=dev --audit-level=high && npm audit --prefix frontend --omit=dev --audit-level=high",
    "check:budgets": "node scripts/check-budgets.js",
    "check:any": "uv run --project . --locked --extra dev python scripts/check_any_guard.py",
    "check:ratchet": "node scripts/quality-ratchet.js",
    "ci": "npm run lint:python && npm run typecheck:backend && npm run check:any && npm run check:ratchet && npm run audit:python && npm run audit:node && npm run typecheck:frontend && npm run check:budgets && npm test",
    "bump:patch": "node scripts/bump-version.js patch",
    "bump:minor": "node scripts/bump-version.js minor",
    "bump:major": "node scripts/bump-version.js major",
    "release:dry-run": "node scripts/release-loop.js",
    "release:ship": "node scripts/release-loop.js --ship",
    "release:full": "node scripts/release-loop.js --ship --build",
    "push:dry-run": "node scripts/push-loop.js",
    "push:ship": "node scripts/push-loop.js --ship",
    "push:merge": "node scripts/push-loop.js --ship --merge",
    "pr-fix": "node scripts/pr-fix-loop.js",
    "pr-fix:ship": "node scripts/pr-fix-loop.js --ship",
    "pr-fix:merge": "node scripts/pr-fix-loop.js --ship --merge",
    "hooks:install": "node scripts/install-hooks.js",
    "postinstall": "electron-builder install-app-deps && node scripts/install-hooks.js || true"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1"
  },
  "overrides": {
    "tar": "^7.5.21",
    "dompurify": "^3.4.13",
    "js-yaml": "^4.3.0",
    "builder-util-runtime": "^9.7.0",
    "nanoid": "^3.3.18"
  }
}
