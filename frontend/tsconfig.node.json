{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.static.config.ts",
    "vitest.sequencer.ts",
    "vitest.durations.json",
    "../shared/budgets.json"
  ]
}
