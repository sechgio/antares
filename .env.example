# Copia a .env.local (NO commitear) o exporta en tu shell antes de npm run dev.
# En repo publico: NUNCA subas valores reales.

# AutoIMG — Google OAuth (app de escritorio en Google Cloud Console)
# Alternativa: configurar desde la UI de AutoIMG (se guarda cifrado en userData).
# En Credenciales OAuth, agrega URI de redirección autorizada: http://127.0.0.1
AUTOIMG_GOOGLE_CLIENT_ID=
AUTOIMG_GOOGLE_CLIENT_SECRET=