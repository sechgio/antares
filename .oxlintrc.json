{
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "react-perf",
    "jsx-a11y",
    "vitest",
    "promise",
    "node"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error",
    "restriction": "error",
    "style": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "dist-electron/**",
    "frontend/dist/**",
    "frontend/coverage/**",
    "node_modules/**",
    "frontend/node_modules/**",
    ".venv/**",
    "scratch/**"
