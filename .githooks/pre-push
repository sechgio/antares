#!/bin/sh

protected_branch="main"

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/"$protected_branch")
      echo ""
      echo "✗ Push directo a '$protected_branch' bloqueado."
      echo "  Usa el pipeline PR-first:"
      echo "    bun run push:dry-run"
      echo "    bun run push:ship -- --message \"tipo: descripción\""
      echo ""
      exit 1
      ;;
  esac
done

node scripts/pre-push-check.js || exit 1

exit 0
